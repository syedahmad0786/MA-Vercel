# ──────────────────────────────────────────────
# New Student Onboarding – Environment Variables
# Copy this file to .env.local and fill in values
# ──────────────────────────────────────────────

# Close CRM
# Your Close CRM API key (found in Settings > API Keys)
CLOSE_CRM_API_KEY=your_close_crm_api_key_here

# Airtable
# Personal Access Token from https://airtable.com/create/tokens
AIRTABLE_API_TOKEN=your_airtable_personal_access_token_here
# Base ID (from URL: airtable.com/appXXXXXXXXXXXXXX)
AIRTABLE_BASE_ID=appgqED05AlPLi0ar

# Slack
# Bot OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# Channel ID where alerts will be posted
SLACK_CHANNEL_ID=C0A11F18N5T

# Intercom
# Access Token from https://app.intercom.com/a/apps/_/settings/api-keys
INTERCOM_API_KEY=your_intercom_access_token_here

# Mighty Networks
# API key / auth value for the Authorization header (e.g. "Token abc123")
MIGHTY_NETWORKS_AUTH=Token your_mighty_networks_api_key_here
# Network ID
MIGHTY_NETWORKS_NETWORK_ID=21685656
# Plan IDs: Gold/Platinum members vs all other tiers
MIGHTY_NETWORKS_GOLD_PLATINUM_PLAN_ID=1960485
MIGHTY_NETWORKS_STANDARD_PLAN_ID=1960487
